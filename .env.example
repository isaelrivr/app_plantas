# Variables de entorno para EcoScan (Demo Académica / Universitaria)
# Copia este archivo a `.env` en la raíz del proyecto para configurarlo.

# ============================================================================
# INTELIGENCIA ARTIFICIAL DIRECTA (GEMINI 1.5 FLASH)
# ============================================================================
# Clave gratuita de Google AI Studio para reconocimiento visual y chat de IA:
# https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash

# ============================================================================
# BACKEND PROXY (OPCIONAL)
# ============================================================================
# Si se utiliza servidor Cloud Functions:
EXPO_PUBLIC_PLANT_AI_ENDPOINT=https://us-central1-plantae-app.cloudfunctions.net

# Forzar catálogo offline de demostración
EXPO_PUBLIC_USE_MOCKS=false
