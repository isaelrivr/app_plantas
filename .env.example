# Variables PÚBLICAS del cliente de Plantae (Expo).
# Todo lo que empieza por EXPO_PUBLIC_ se incrusta en el bundle de la app, así
# que aquí NUNCA debe haber secretos. Las claves de Plant.id / Gemini / Firebase
# viven solo en `functions/.env` (servidor).
#
# Copia este archivo a `.env` y ajusta los valores.

# URL base de las Cloud Functions de Plantae (sin barra final).
# En desarrollo local con el emulador: http://localhost:5001/<tu-proyecto>/us-central1
EXPO_PUBLIC_PLANT_AI_ENDPOINT=https://us-central1-plantae-app.cloudfunctions.net

# SOLO desarrollo: cuando es "true", la app usa proveedores simulados
# (identificación, cuidados y salud) sin llamar al backend. En producción
# el código exige el endpoint real.
EXPO_PUBLIC_USE_MOCKS=false
