# Variables de entorno para EcoScan
# Copia este archivo a `.env` en la raíz del proyecto para configurarlo.

# ============================================================================
# BACKEND PROXY SEGURO DE INTELIGENCIA ARTIFICIAL
# ============================================================================
# URL base del proxy en Cloud Functions (sin barra final).
# Las API keys de Google Gemini y Plant.id residen ÚNICAMENTE en el servidor.
# El binario de la aplicación no contiene secretos ni claves de API.
# En desarrollo local: http://192.168.1.XX:5001/<proyecto>/us-central1
EXPO_PUBLIC_PLANT_AI_ENDPOINT=https://us-central1-plantae-app.cloudfunctions.net

# SOLO desarrollo: "true" fuerza el uso de datos simulados locales sin conexión.
EXPO_PUBLIC_USE_MOCKS=false
